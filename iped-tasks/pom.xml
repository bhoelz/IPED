<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>iped</groupId>
        <artifactId>iped-parent</artifactId>
        <version>4.4.0</version>
    </parent>

    <artifactId>iped-tasks</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>iped-tasks.spi</module>
        <module>iped-tasks-bom</module>
        <module>iped-tasks-core</module>
        <module>iped-tasks-transcript</module>
        <module>iped-tasks-image</module>
        <module>iped-tasks-storage-index</module>
        <module>iped-tasks-carving</module>
        <module>iped-tasks-graph</module>
        <module>iped-tasks-report</module>
        <module>iped-tasks-forensics</module>
        <module>iped-tasks-cli</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>iped</groupId>
                <artifactId>iped-tasks-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Enables JUnit 4 test discovery via JUnit Platform (required by surefire's JUnitPlatformProvider) -->
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Make task plugin JARs available in the release plugins folder -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-plugin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${plugin.dir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>${project.build.finalName}.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>maven-cognitiveservices-speech</id>
            <name>Microsoft Cognitive Services Speech Maven Repository</name>
            <url>https://csspeechstorage.blob.core.windows.net/maven/</url>
        </repository>
        <repository>
            <id>maven-vosk</id>
            <name>Alphaceph Vosk Java Maven Repo</name>
            <url>https://alphacephei.com/maven/</url>
        </repository>
    </repositories>
</project>
