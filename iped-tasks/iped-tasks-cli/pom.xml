<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>iped</groupId>
        <artifactId>iped-tasks</artifactId>
        <version>4.4.0</version>
        <relativePath>..</relativePath>
    </parent>

    <artifactId>iped-tasks-cli</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>iped</groupId>
            <artifactId>iped-tasks.spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>iped</groupId>
            <artifactId>iped-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- TaskInstallerConfig.getNewTaskInstances() eagerly instantiates every task
             in the configured pipeline (TaskInstaller.toml), not just the one this CLI
             was asked to run, so every task-plugin module needs to be resolvable via
             Class.forName. Mirrors iped-app/pom.xml's own dependency list (the only
             other consumer that needs the full task set on its classpath rather than
             loading plugin JARs dynamically at runtime). -->
        <dependency>
            <groupId>iped</groupId>
            <artifactId>iped-tasks-transcript</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>iped</groupId>
            <artifactId>iped-tasks-image</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>iped</groupId>
            <artifactId>iped-tasks-storage-index</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>iped</groupId>
            <artifactId>iped-tasks-graph</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>iped</groupId>
            <artifactId>iped-tasks-forensics</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>iped</groupId>
            <artifactId>iped-tasks-report</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>iped</groupId>
            <artifactId>iped-geo</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Version kept in sync with iped-engine's own jcommander dependency -->
        <dependency>
            <groupId>com.beust</groupId>
            <artifactId>jcommander</artifactId>
            <version>1.82</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Same add-opens flags as the shaded jar's manifest (see below), needed
                 for the Surefire-forked JVM since it doesn't read that manifest. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        --add-opens=java.base/java.util=ALL-UNNAMED
                        --add-opens=java.base/java.util.concurrent=ALL-UNNAMED
                        --add-opens=java.base/java.lang=ALL-UNNAMED
                        --add-opens=java.base/java.math=ALL-UNNAMED
                        --add-opens=java.base/java.net=ALL-UNNAMED
                        --add-opens=java.base/java.io=ALL-UNNAMED
                        --add-opens=java.base/java.nio=ALL-UNNAMED
                        --add-opens=java.base/java.text=ALL-UNNAMED
                        --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>

            <!-- Standalone executable tool, not a task-plugin: don't copy it into the
                 plugins folder that TaskInstaller loads at runtime (see iped-tasks.spi/pom.xml
                 for the same override). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-plugin-jar</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- Fat JAR with all dependencies, runnable via `java -jar iped-tasks-cli.jar` -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>iped-tasks-cli</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- Several task classes (e.g. RegexTask, via FST serialization) need deep
                                     reflection into java.base at class-init time. The full app's
                                     iped.app.bootstrap.Bootstrap relaunches the JVM with equivalent add-opens
                                     flags; a plain "java -jar" launch has no such relaunch step, but the
                                     JVM honors an Add-Opens manifest attribute automatically since Java 9. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>iped.tasks.cli.StandaloneTaskCli</mainClass>
                                    <manifestEntries>
                                        <Add-Opens>java.base/java.util java.base/java.util.concurrent java.base/java.lang java.base/java.math java.base/java.net java.base/java.io java.base/java.nio java.base/java.text java.base/sun.nio.ch</Add-Opens>
                                    </manifestEntries>
                                </transformer>
                                <!-- Merge META-INF/services for SPI files (e.g. Tika parsers) -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
