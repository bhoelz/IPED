{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "iped-webui": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "iped",
      "architect": {
        "islands": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/islands/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "outputPath": "dist/islands",
            "index": false,
            "outputHashing": "all",
            "optimization": true,
            "polyfills": [],
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "300kB",
                "maximumError": "600kB"
              },
              {
                "type": "anyComponentStyle",
                "maximumWarning": "12kB",
                "maximumError": "15kB"
              }
            ]
          },
          "configurations": {
            "development": {
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": true
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
