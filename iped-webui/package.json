{
  "name": "iped-webui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:islands": "ng run iped-webui:islands && node scripts/generate-islands-manifest.mjs",
    "build:islands:dev": "ng run iped-webui:islands:development && node scripts/generate-islands-manifest.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "node ./scripts/generate-api-client.mjs",
    "generate:python": "openapi-generator-cli generate -i ../specs/84-phase-1-openapi-initial.yaml -g python -o dist/python-client --additional-properties=packageName=iped_client",
    "test:contract": "tsc --noEmit --project tsconfig.app.json"
  },
  "private": true,
  "packageManager": "npm@11.2.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/elements": "21.2.13",
    "@angular/platform-browser": "^21.2.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@openapitools/openapi-generator-cli": "^2.33.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
