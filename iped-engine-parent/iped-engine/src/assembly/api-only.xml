<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
    <id>api-only</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <!-- Include all files from the jar (not other jars) -->
    <fileSets>
        <fileSet>
            <directory>${project.build.outputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>iped/engine/config/**</include>
            </includes>
        </fileSet>
    </fileSets>

    <!-- Include only essential dependencies -->
    <dependencySets>
        <dependencySet>
            <useProjectArtifact>false</useProjectArtifact>
            <outputDirectory>lib</outputDirectory>
            <scope>runtime</scope>
            <includes>
                <!-- Jetty/Jersey for REST API -->
                <include>org.eclipse.jetty:jetty-server</include>
                <include>org.eclipse.jetty:jetty-servlet</include>
                <include>org.glassfish.jersey.core:jersey-server</include>
                <include>org.glassfish.jersey.core:jersey-common</include>
                <include>org.glassfish.jersey.containers:jersey-container-servlet</include>
                <include>org.glassfish.jersey.media:jersey-media-json-jackson</include>

                <!-- Jackson for JSON -->
                <include>com.fasterxml.jackson.core:jackson-databind</include>
                <include>com.fasterxml.jackson.core:jackson-core</include>
                <include>com.fasterxml.jackson.core:jackson-annotations</include>

                <!-- Logging -->
                <include>org.slf4j:slf4j-api</include>
                <include>org.slf4j:slf4j-simple</include>
                <include>org.slf4j:jul-to-slf4j</include>

                <!-- Configuration management -->
                <include>iped:iped-engine-core</include>
                <include>iped:iped-api</include>

                <!-- Core utilities (minimal) -->
                <include>commons-io:commons-io</include>
                <include>commons-lang:commons-lang</include>
            </includes>
        </dependencySet>
    </dependencySets>
</assembly>
