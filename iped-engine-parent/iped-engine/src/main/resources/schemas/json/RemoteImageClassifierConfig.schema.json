{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iped.digital-forensics.org/schema/RemoteImageClassifierConfig.schema.json",
  "title": "Remote Image Classifier Configuration",
  "description": "Configuration for remote image classification services",
  "type": "object",
  "properties": {
    "enableImageClassification": {
      "type": "boolean",
      "description": "Enable remote image classification",
      "default": false
    },
    "classificationService": {
      "type": "string",
      "description": "Image classification service to use",
      "enum": ["google-vision", "azure-cv", "aws-rekognition"],
      "default": "google-vision"
    },
    "apiKey": {
      "type": "string",
      "description": "API key for classification service"
    },
    "classificationThreshold": {
      "type": "number",
      "description": "Confidence threshold for classifications",
      "default": 0.5,
      "minimum": 0.0,
      "maximum": 1.0
    },
    "enableLabels": {
      "type": "boolean",
      "description": "Extract object labels",
      "default": true
    }
  },
  "additionalProperties": false
}
