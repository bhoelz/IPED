{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iped.digital-forensics.org/schema/CarverTaskConfig.schema.json",
  "title": "Carver Task Configuration",
  "description": "Loaded carver type definitions (CarverConfig.toml/.xml + carver-*.xml overrides). Whether carving runs at all is controlled separately by the 'enableCarving' task-enable property, not by this object.",
  "type": "object",
  "properties": {
    "carverTypes": {
      "type": "array",
      "description": "File types to carve",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Carver type identifier"
          },
          "mimeType": {
            "type": "string",
            "description": "Output MIME type"
          },
          "minLength": {
            "type": "integer",
            "description": "Minimum file size in bytes"
          },
          "maxLength": {
            "type": "integer",
            "description": "Maximum file size in bytes"
          }
        },
        "required": ["name", "mimeType"]
      }
    },
    "toIgnoreCorrupted": {
      "type": "boolean",
      "description": "Continue carving even on corrupted files",
      "default": true
    }
  }
}
