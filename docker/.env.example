# ─────────────────────────────────────────────────────────────────────────────
# IPED Distributed — example environment file
#
# Copy to .env and adjust before running docker compose:
#   cp docker/.env.example docker/.env
#   docker compose --env-file docker/.env up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Case identifier — must match the caseId used by IPED readers.
# Kafka topics are named  iped.<CASE_ID>.stage.<N>
# Allowed characters: letters, digits, hyphens, underscores.
CASE_ID=my-case-001

# ── Kafka ─────────────────────────────────────────────────────────────────────

# Bootstrap server reachable from inside Docker containers
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Bootstrap server reachable from outside Docker (IPED readers on the host)
KAFKA_EXTERNAL_PORT=9094

# ── Coordinator ───────────────────────────────────────────────────────────────

COORDINATOR_PORT=8484

# Seconds without heartbeat before an agent is considered dead
AGENT_EXPIRY_SECONDS=30

# Number of Kafka partitions per pipeline topic
# (set to at least the maximum number of parallel workers for any task type)
TOPIC_PARTITIONS=8

# Kafka replication factor — increase to 3 for production clusters
TOPIC_REPLICATION_FACTOR=1

# Seconds between agent heartbeat calls
HEARTBEAT_INTERVAL_SECONDS=10

# Seconds before a single item/task combination is considered timed out
ITEM_TIMEOUT_SECONDS=3600

# ── Workers ───────────────────────────────────────────────────────────────────

# Default parallelism (threads per worker JVM); override per service in compose
AGENT_PARALLELISM=4

# Enable Kafka exactly-once semantics (slower but prevents duplicate processing)
EXACTLY_ONCE=false

# Failed attempts per stage before an item is parked in the DLQ (0 = no retries)
MAX_RETRIES=3

# Base delay of the exponential retry backoff (Nth retry waits base * 2^(N-1) s)
RETRY_BACKOFF_BASE_SECONDS=30

# Shared storage root (must be the SAME absolute path on every node)
SHARED_STORAGE_ROOT=/mnt/iped-shared
